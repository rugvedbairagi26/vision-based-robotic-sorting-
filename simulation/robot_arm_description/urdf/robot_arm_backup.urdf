<?xml version="1.0"?>
<robot name="color_sorting_arm">

  <!-- Fixed base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.015"/>
      <geometry>
        <box size="0.15 0.15 0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.12 0.12 0.12 1"/>
      </material>
    </visual>
  </link>

  <!-- Rotating base assembly -->
  <link name="base_rotation_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="0.04" length="0.10"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- J1: rotates the entire arm left/right -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="base_rotation_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>

  <!-- Upper arm -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.0525"/>
      <geometry>
        <box size="0.035 0.035 0.105"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
  </link>

  <!-- J2: shoulder -->
  <joint name="joint2" type="revolute">
    <parent link="base_rotation_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>


  <!-- Forearm: J3 to J4 = 12.7 cm -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.0635"/>
      <geometry>
        <box size="0.03 0.03 0.127"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.7 0.3 1"/>
      </material>
    </visual>
  </link>

  <!-- J3: elbow bending joint -->
  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>

  <!-- Wrist section: J4 to J5 = 7 cm -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry>
        <box size="0.025 0.025 0.07"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- J4: wrist bending joint -->
  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.127" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>

  
  <!-- Simplified gripper mounting body -->
  <link name="gripper_mount_link">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
  </link>

  <!-- J5: rotates the gripper around its length -->
  <joint name="joint5" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_mount_link"/>

    <!-- J4 to J5 = 7 cm -->
    <origin xyz="0 0 0.07" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <!-- Temporary simulation limits -->
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>
  
  <!-- Fixed gripper finger -->
  <link name="fixed_finger_link">
    <visual>
      <origin xyz="0 -0.025 0.055"/>
      <geometry>
        <box size="0.012 0.012 0.07"/>
      </geometry>
      <material name="gray_finger">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
  </link>

  <joint name="fixed_finger_joint" type="fixed">
    <parent link="gripper_mount_link"/>
    <child link="fixed_finger_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Moving gripper finger -->
  <link name="moving_finger_link">
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry>
        <box size="0.012 0.012 0.07"/>
      </geometry>
      <material name="gray_moving_finger">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
  </link>

  <!-- J6: simplified gripper opening and closing -->
  <joint name="joint6" type="prismatic">
    <parent link="gripper_mount_link"/>
    <child link="moving_finger_link"/>
    <origin xyz="0 0.025 0.04" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.035"
           effort="10" velocity="0.05"/>
  </joint>
</robot>