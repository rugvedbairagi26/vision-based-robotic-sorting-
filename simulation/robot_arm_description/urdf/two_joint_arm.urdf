<?xml version="1.0"?>

<robot name="two_joint_arm">

  <!-- Base: the stationary part of the robot -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.12 0.12 0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <!-- First moving link -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry>
        <box size="0.04 0.04 0.20"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.9 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Joint connecting the base and link1 -->
  
<joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>

    <origin xyz="0 0 0.025" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
</joint>

  <!-- Second moving link -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.075"/>
      <geometry>
        <box size="0.03 0.03 0.15"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.3 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Joint connecting link1 and link2 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>

</robot>